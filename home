<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Developer Hub - Self Service Home</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      min-height: 100%;
      overflow: hidden;
      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      color: #0d2255;
      background: #f8faff;
    }

    body {
      min-width: 1100px;
    }

    .app-shell {
      height: 100vh;
      min-height: 100vh;
      display: flex;
      overflow: hidden;
      background:
        radial-gradient(
          circle at 70% 15%,
          rgba(219, 228, 255, 0.24),
          transparent 25%
        ),
        #fbfcff;
    }

    /* ===============================
       LEFT SIDEBAR
    ================================= */

    .sidebar {
      width: 265px;
      height: 100vh;
      min-height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      padding: 28px 20px 30px;
      color: white;
      background:
        radial-gradient(
          circle at 0% 100%,
          rgba(0, 102, 255, 0.34),
          transparent 45%
        ),
        linear-gradient(180deg, #092552 0%, #06235a 48%, #073b85 100%);
      box-shadow: 8px 0 28px rgba(15, 38, 88, 0.08);
      z-index: 20;
    }

    .brand {
      display: flex;
      align-items: flex-start;
      gap: 13px;
      padding: 1px 5px 32px;
    }

    .brand-icon {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
    }

    .brand-title {
      font-size: 18px;
      font-weight: 700;
      margin-top: 2px;
      line-height: 1.2;
    }

    .brand-version {
      font-size: 12px;
      color: #bbc9e6;
      margin-top: 5px;
    }

    .nav {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .nav-item {
      height: 58px;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 0 16px;
      border-radius: 11px;
      color: #ffffff;
      text-decoration: none;
      font-size: 17px;
      font-weight: 600;
      transition: 0.2s ease;
      cursor: pointer;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.07);
    }

    .nav-item.active {
      background: linear-gradient(135deg, #1168e8, #246df4);
      box-shadow: 0 12px 25px rgba(0, 70, 210, 0.24);
    }

    .nav-icon {
      width: 23px;
      height: 23px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .sidebar-bottom {
      margin-top: auto;
      padding-bottom: 18px;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .bottom-item {
      height: 42px;
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 0 6px;
      color: #ffffff;
      font-size: 14px;
      font-weight: 600;
    }

    /* ===============================
       RIGHT SIDE
    ================================= */

    .page {
      margin-left: 265px;
      width: calc(100% - 265px);
      height: 100vh;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ===============================
       HEADER
    ================================= */

    .topbar {
      height: 92px;
      background: rgba(255, 255, 255, 0.96);
      border-bottom: 1px solid #dbe2ef;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 28px 0 40px;
      box-shadow: 0 1px 3px rgba(19, 52, 101, 0.02);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 29px;
    }

    .self-home {
      font-size: 13px;
      color: #53668f;
      font-weight: 600;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #405a89;
      color: white;
      font-size: 13px;
      font-weight: 500;
    }

    .profile-text {
      line-height: 1.25;
      min-width: 92px;
    }

    .profile-name {
      color: #40517a;
      font-size: 13px;
      font-weight: 700;
    }

    .profile-role {
      color: #62739a;
      font-size: 12px;
      margin-top: 3px;
    }

    .chevron {
      width: 16px;
      height: 16px;
      color: #68789d;
    }

    /* ===============================
       MAIN CONTENT
    ================================= */

    .main {
      flex: 1;
      min-height: 0;
      padding: 38px 40px 28px;
      overflow: hidden;
      background:
        linear-gradient(
          180deg,
          rgba(247, 250, 255, 0.3),
          rgba(255, 255, 255, 0.72)
        );
    }

    .content-wrap {
      width: 100%;
      max-width: 1180px;
      height: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
    }

    .hero {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      min-height: 128px;
      gap: 40px;
      flex-shrink: 0;
    }

    .hero-copy {
      padding-top: 3px;
    }

    .hero h1 {
      margin: 0;
      font-size: 38px;
      letter-spacing: -1px;
      line-height: 1.15;
      font-weight: 800;
      color: #0c2156;
    }

    .hero p {
      margin: 18px 0 0;
      font-size: 16px;
      color: #52658f;
      font-weight: 400;
    }

    .hero-art {
      width: 250px;
      height: 122px;
      margin-top: -8px;
      flex-shrink: 0;
    }

    /* ===============================
       INFO BOX
    ================================= */

    .info-box {
      margin-top: 4px;
      width: 100%;
      min-height: 102px;
      height: 102px;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid #dde4f0;
      border-radius: 15px;
      box-shadow:
        0 5px 18px rgba(44, 71, 121, 0.08),
        0 1px 2px rgba(0, 0, 0, 0.02);
      display: flex;
      align-items: center;
      padding: 20px 25px;
    }

    .info-icon {
      width: 54px;
      height: 54px;
      border-radius: 13px;
      background: #edf2ff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-right: 24px;
    }

    .info-top {
      font-size: 16px;
      color: #5a6e99;
      margin-bottom: 10px;
    }

    .info-bottom {
      font-size: 18px;
      font-weight: 700;
      color: #102358;
    }

    /* ===============================
       PLATFORM CARDS
    ================================= */

    .cards {
      margin: 42px auto 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 38px;
      width: 90%;
      flex: 1;
      min-height: 0;
    }

    .platform-card {
      position: relative;
      min-height: 0;
      height: 100%;
      max-height: 340px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid #e0e6f1;
      border-top: 2px solid #1e65f3;
      box-shadow:
        0 9px 24px rgba(32, 61, 114, 0.08),
        0 1px 3px rgba(34, 51, 84, 0.05);
      padding: 25px 36px 28px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .platform-card:hover {
      transform: translateY(-3px);
      box-shadow:
        0 15px 30px rgba(32, 61, 114, 0.11),
        0 2px 4px rgba(34, 51, 84, 0.05);
    }

    .platform-logo-circle {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 42% 35%, #f2f5ff 0%, #e6edff 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .platform-title {
      font-size: 21px;
      line-height: 1.3;
      color: #0d2255;
      margin: 0;
      font-weight: 800;
    }

    .platform-description {
      color: #586b98;
      font-size: 15px;
      line-height: 1.55;
      margin-top: 18px;
      max-width: 320px;
    }

    .arrow-button {
      margin-top: auto;
      width: 56px;
      height: 56px;
      border-radius: 12px;
      border: 1px solid #d9e3fa;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .arrow-button:hover {
      background: #f5f8ff;
      border-color: #b8cdfa;
      transform: translateX(2px);
    }

    /* ===============================
       FOOTER
    ================================= */

    .footer {
      height: 64px;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.96);
      border-top: 1px solid #dce3ef;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 47px 0 34px;
      font-size: 13px;
      color: #5c6f94;
    }

    .footer-time {
      text-align: right;
      line-height: 1.35;
      color: #43577d;
      font-size: 13px;
    }


    @media (max-height: 820px) {
      .topbar {
        height: 76px;
      }

      .main {
        padding: 24px 36px 20px;
      }

      .hero {
        min-height: 105px;
      }

      .hero h1 {
        font-size: 34px;
      }

      .hero p {
        margin-top: 12px;
        font-size: 15px;
      }

      .hero-art {
        width: 215px;
        height: 104px;
      }

      .info-box {
        height: 88px;
        min-height: 88px;
        padding: 16px 22px;
      }

      .info-icon {
        width: 48px;
        height: 48px;
      }

      .cards {
        margin-top: 30px;
      }

      .platform-card {
        max-height: 300px;
        padding: 19px 30px 22px;
      }

      .platform-logo-circle {
        width: 58px;
        height: 58px;
        margin-bottom: 13px;
      }

      .platform-logo-circle svg {
        width: 43px;
        height: 43px;
      }

      .platform-title {
        font-size: 19px;
      }

      .platform-description {
        margin-top: 13px;
        font-size: 14px;
        line-height: 1.45;
      }

      .arrow-button {
        width: 48px;
        height: 48px;
      }

      .footer {
        height: 54px;
      }
    }

    @media (max-width: 1250px) {
      .cards {
        width: 100%;
      }

      .content-wrap {
        max-width: 960px;
      }

      .hero h1 {
        font-size: 36px;
      }
    }

    /* 27-inch QHD / large desktop */
    @media (min-width: 2000px) {
      .content-wrap {
        max-width: 1280px;
      }

      .cards {
        width: 88%;
        gap: 48px;
      }
    }

    /* Taller QHD screens: use the extra vertical room without creating scroll */
    @media (min-width: 2000px) and (min-height: 1200px) {
      .main {
        padding: 54px 48px 34px;
      }

      .hero {
        min-height: 150px;
      }

      .hero-art {
        width: 300px;
        height: 142px;
      }

      .info-box {
        min-height: 112px;
        height: 112px;
      }

      .cards {
        margin-top: 50px;
      }

      .platform-card {
        max-height: 390px;
        padding: 31px 40px 32px;
      }

      .platform-logo-circle {
        width: 76px;
        height: 76px;
        margin-bottom: 22px;
      }

      .platform-description {
        margin-top: 22px;
        font-size: 15.5px;
        line-height: 1.6;
      }

      .arrow-button {
        width: 60px;
        height: 60px;
      }
    }
  </style>
</head>

