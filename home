        <div class="topbar-right">
          <div class="self-home">Self Serve Home</div>

          <div class="profile">
            <div class="avatar">JK</div>

            <div class="profile-text">
              <div class="profile-name">Jahnavi Kurra</div>
              <div class="profile-role">Admin</div>
