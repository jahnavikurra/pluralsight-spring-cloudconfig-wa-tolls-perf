
SELECT
    OBJECT_NAME(fkc.parent_object_id) AS ChildTable,
    COL_NAME(
        fkc.parent_object_id,
        fkc.parent_column_id
    ) AS ChildColumn,

    OBJECT_NAME(fkc.referenced_object_id) AS ParentTable,
    COL_NAME(
        fkc.referenced_object_id,
        fkc.referenced_column_id
    ) AS ParentColumn

FROM sys.foreign_key_columns fkc

WHERE
    OBJECT_SCHEMA_NAME(fkc.parent_object_id) = 'dbo'
    AND OBJECT_SCHEMA_NAME(fkc.referenced_object_id) = 'dbo'

ORDER BY
    ParentTable,
    ChildTable;


SELECT
    p.project_name,
    p.ado_project_id,

    t.*,
    tp.*,
    dp.domain_prefix,
    dp.description AS domain_description

FROM dbo.teams t

LEFT JOIN dbo.projects p
    ON t.project_id = p.id

LEFT JOIN dbo.team_prefixes tp
    ON tp.team_id = t.id

LEFT JOIN dbo.domain_prefixes dp
    ON dp.id = tp.domain_prefix_id

ORDER BY
    p.project_name,
    t.id;



SELECT
    p.project_name,

    t.*,
    tp.*,

    dp.domain_prefix,

    tor.*

FROM dbo.team_onboarding_requests tor

LEFT JOIN dbo.teams t
    ON tor.team_id = t.id

LEFT JOIN dbo.projects p
    ON t.project_id = p.id

LEFT JOIN dbo.team_prefixes tp
    ON tor.team_prefix_id = tp.id

LEFT JOIN dbo.domain_prefixes dp
    ON tor.domain_prefix_id = dp.id

ORDER BY
    p.project_name,
    tor.team_id;



